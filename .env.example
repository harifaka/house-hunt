# Server
# Cloud Run injects PORT automatically (defaults to 8080 in the Dockerfile)
PORT=8080
NODE_ENV=development

# Session
SESSION_SECRET=your-secret-key-here

# Cloudflare D1 (database)
# API token needs the "D1 Edit" permission for the target account.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
# Optional: override the REST endpoint (useful for local D1 proxies / tests)
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# Cloudflare R2 (image storage, S3-compatible API)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=house-hunt-images
# Public bucket domain or custom domain used to build image URLs
R2_PUBLIC_DOMAIN=https://images.example.com
# Optional: folder prefix for uploaded objects (default: house-hunt/images)
# R2_OBJECT_KEY_PREFIX=house-hunt/images

# Logging / Audit
# Number of days to retain audit logs before automatic cleanup (default: 30)
LOG_RETENTION_DAYS=30

# AI Configuration (optional — can also be set via the admin UI)
# AI_PROVIDER=openai
# AI_ENDPOINT=https://api.openai.com/v1
# AI_MODEL=gpt-4
# AI_API_KEY=your-api-key-here

# DeepSeek Vision (on-demand property photo analysis)
# DeepSeek is OpenAI API compatible. Point DEEPSEEK_BASE_URL at an
# OpenRouter-compatible endpoint if you prefer to route through OpenRouter.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
